{
  "name": "@cocreate/position",
  "version": "2.0.2",
  "description": "Declarative DOM positioning, dragging, snapping, and drag-and-drop for web interfaces.",
  "keywords": [
    "positioning",
    "drag-and-drop",
    "draggable",
    "snapping",
    "floating-ui",
    "popover",
    "tooltip",
    "iframe",
    "declarative",
    "dom",
    "cocreate"
  ],
  "publishConfig": {
