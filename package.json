  "bugs": {
    "url": "https://github.com/CoCreateJS/position/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/position",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/observer": "^2.0.1",
    "@cocreate/utils": "^2.0.2"
  },
  "devDependencies": {
    "@cocreate/webpack": "^2.0.1",
    "playwright-core": "^1.64.1"
  },
  "allowScripts": {
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
